---
import { pricingCards } from "@const";
import Layout from "@layouts/Layout.astro";
import Pricing from "@components/Pricing.astro";
import Card from "@components/Card.astro";

const [recomended, premium] = pricingCards;
---

<Layout title="Welcome to Astro.">
  <main>
    <header class="header">
      <h1>Try Pulse free for 30 days.</h1>
      <p class="subtitle">
        See why Pulse is the best way to monitor your cash flow. Sign up for any
        plan and try Pulse absolutely free for 30 days.
      </p>
    </header>
    <section class="pricing">
      <Pricing />
      <Card
        title="Small Business Plan"
        subtitle="$59 per month"
        list={recomended}
      />
      <Card
        title="Unlock Extra Features"
        subtitle="$89 per month"
        list={premium}
        recomended={false}
      />
    </section>
  </main>
</Layout>

<style>
  main {
    padding: 2rem;
  }

  .header {
    display: flex;
    flex-direction: column;
  }

  h1,
  .subtitle {
    color: var(--black);
  }

  h1 {
    font-size: 3.8rem;
    font-weight: 700;
    max-width: 600px;
    margin-bottom: 1rem;
  }

  .subtitle {
    font-size: 1.4rem;
    max-width: 620px;
  }

  .pricing {
    display: flex;
    flex-direction: column;
    padding: 1.6rem 0;
    row-gap: 1.6rem;
  }

  @media screen and (min-width: 768px) {
    main {
      padding: 0 1rem;
    }
  }

  @media screen and (min-width: 992px) {
    .header {
      align-items: center;
    }

    h1,
    .subtitle {
      text-align: center;
    }
  }
</style>
