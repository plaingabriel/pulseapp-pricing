---
const { title, subtitle, list, recomended = true } = Astro.props;
---

<a href="/" class=`${recomended ? "card-recommended" : "card"}`>
  <div class=`heading ${recomended ? "recomended" : "normal"}`>
    {
      recomended
        ? "Recommended"
        : "Complex business with multiple financial accounts, currencies, or auditing needs?"
    }
  </div>

  <div class="body">
    <header>
      <div class=`${recomended ? "title-recomended" : "title"}`>{title}</div>
      <div class="subtitle">{subtitle}</div>
    </header>

    <div class="reverse-wrapper">
      <div class="main">
        <div class="list-title">{list.title}</div>

        <ul class="list">
          {list.content.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>

      <footer>
        <div class="cta-btn">
          <span class="cta-btn__text"
            >{recomended ? "Sign Up Now" : "Try Premium"}</span
          >
        </div>
      </footer>
    </div>
  </div>
</a>

<style>
  .card,
  .card-recommended {
    width: 100%;
  }

  .card {
    border: 1px solid var(--gray);
  }

  .card-recommended {
    border: 1px solid var(--green);
    border-radius: 10px 10px 0 0;
  }

  li::before {
    content: "✓";
    margin-right: 0.5rem;
    font-weight: bold;
    color: var(--green);
  }

  .heading {
    background-color: var(--subtle-gray);
    color: var(--slate-gray);
    text-align: center;
    padding: 1rem;
    border-bottom: 1px solid var(--gray);
    font-size: 1.2rem;
  }

  .recomended {
    background-color: var(--green);
    color: var(--white);
    font-weight: bold;
    text-transform: uppercase;
    border-radius: 10px 10px 0 0;
  }

  .reverse-wrapper {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .body {
    background-color: var(--white);
    padding: 15px;
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
  }

  @media screen and (min-width: 610px) {
    header {
      flex-direction: row;
      justify-content: start;
      align-items: end;
    }
  }

  .title,
  .title-recomended {
    color: var(--green);
    line-height: 0.7;
    font-size: 2.8rem;
  }

  .title-recomended {
    font-weight: bold;
  }

  .subtitle {
    color: var(--slate-gray);
    font-size: 2rem;
    opacity: 0.8;
    line-height: 0.7;
  }

  .main {
    color: var(--slate-gray);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.2rem;
  }

  .list-title {
    font-weight: bold;
    opacity: 0.9;
    text-transform: uppercase;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  :is(.card, .card-recommended):hover :is(.cta-btn__text, .main, .normal) {
    color: var(--black);
  }

  .cta-btn {
    font-size: 1.3rem;
    font-weight: bold;
    background-color: var(--ligth-green);
    color: var(--black);
    text-align: center;
    padding: 10px 0;
  }

  .cta-btn__text {
    color: var(--slate-gray);
    transition: color 0.1s ease-in-out;
  }

  @media screen and (min-width: 992px) {
    .body {
      padding: 4rem 2rem;
    }

    .reverse-wrapper {
      flex-direction: column-reverse;
      row-gap: 2rem;
    }

    header {
      flex-direction: column;
      align-items: center;
    }

    header > *:first-child {
      text-align: center;
      max-width: 300px;
      line-height: 1;
    }

    .title-recomended {
      font-size: 3.6rem;
    }

    .heading {
      font-size: 1rem;
    }

    .recomended {
      padding: 0.5rem 0;
    }

    .cta-btn {
      width: fit-content;
      padding: 1rem 2.8rem;
      transition: all 0.1s ease;
    }

    :is(.card, .card-recommended):hover .cta-btn {
      transform: scale(1.15);
    }

    footer {
      display: flex;
      justify-content: center;
    }

    .list-title {
      text-align: center;
      opacity: 1;
      font-size: 0.9rem;
    }

    .main {
      font-size: 1.1rem;
    }
  }
</style>
