---
import "@fontsource-variable/work-sans/wght.css";
import Header from "@components/Header.astro";
import Prefooter from "@components/Prefooter.astro";
import Footer from "@components/Footer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Astro description" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header />
    <slot />
    <Prefooter />
    <Footer />
  </body>
</html>

<script>
  const toggle = document.querySelector("input[name=toggle]");
  const menu = document.querySelector(".menu");
  const main = document.querySelector("main");
  const prefooter = document.querySelector(".prefooter");
  const footer = document.querySelector(".footer");
  const bodyChildrensArr = [main, prefooter, footer];

  const makeDissapear = (element: any) => {
    // @ts-ignore
    element.style.animation = "dissappear 0.3s ease-in-out both";
  };

  const makeAppear = (element: any) => {
    // @ts-ignore
    element.style.animation = "appear 0.3s ease-in-out both";
  };

  const makeBlock = (element: any) => {
    // @ts-ignore
    element.style.display = "block";
  };

  const makeNone = (element: any) => {
    // @ts-ignore
    element.style.display = "none";
  };

  const removeAnimation = (element: any) => {
    // @ts-ignore
    element.style.animation = "none";
  };

  const handleMenu = () => {
    // @ts-ignore
    if (toggle.checked) {
      bodyChildrensArr.forEach((child) => makeDissapear(child));

      // @ts-ignore
      menu.style.animation = "none";

      setTimeout(() => {
        bodyChildrensArr.forEach((child) => makeNone(child));

        // @ts-ignore
        menu.style.display = "block";
      }, 300);
    } else {
      // @ts-ignore
      menu.style.animation = "menu-dissappear 0.3s ease-in-out both";

      bodyChildrensArr.forEach((child) => makeAppear(child));

      setTimeout(() => {
        bodyChildrensArr.forEach((child) => makeBlock(child));

        // @ts-ignore
        menu.style.display = "none";
      }, 300);
    }

    window.addEventListener("resize", () => {
      if (window.innerWidth > 768) {
        // @ts-ignore
        menu.style.display = "flex";
        // @ts-ignore
        menu.style.animation = "none";

        bodyChildrensArr.forEach((child) => makeBlock(child));

        bodyChildrensArr.forEach((child) => removeAnimation(child));
      } else {
        // @ts-ignore
        if (toggle.checked) {
          // @ts-ignore
          menu.style.display = "block";

          bodyChildrensArr.forEach((child) => makeNone(child));
        } else {
          // @ts-ignore
          menu.style.display = "none";

          bodyChildrensArr.forEach((child) => makeBlock(child));
        }
      }
    });
  };

  toggle.addEventListener("change", handleMenu);

  // window.addEventListener("resize", () => {
  //   console.log(window.innerWidth);
  // });
</script>

<style is:global>
  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  :root {
    --green: #00ad6a;
    --ligth-green: #1fe374;
    --subtle-green: #eafaf1;
    --gray: #d6dae5;
    --subtle-gray: #f2f3f5;
    --black: #080c16;
    --black-shadow: #080c16ab;
    --white: #fcfcfc;
    --max-width: 1200px;
    --slate-gray: #4d4e52;
    font-size: 12px;
  }

  @media screen and (min-width: 992px) {
    :root {
      font-size: 14px;
    }
  }

  body {
    font-family: "Work Sans Variable", sans-serif;
    background-color: var(--subtle-green);
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  body > :is(header, main) {
    width: 100%;
    max-width: var(--max-width);
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  li {
    list-style: none;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: normal;
  }

  button {
    font-family: inherit;
    border: none;
    outline: none;
    cursor: pointer;
    background: transparent;
    font-size: inherit;
  }

  p {
    text-wrap: pretty;
  }

  p,
  a,
  li {
    line-height: 1.5;
  }

  @keyframes item-appear {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes menu-dissappear {
    from {
      opacity: 1;
      transform: translateY(0);
    }
    to {
      opacity: 0;
      transform: translateY(20px);
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes dissappear {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
